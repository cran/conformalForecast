Package: conformalForecast
Title: Conformal Prediction Methods for Multistep-Ahead Time Series
        Forecasting
Version: 0.2.0
Authors@R: c(
    person("Xiaoqian", "Wang", , "Xiaoqian.Wang@amss.ac.cn",
